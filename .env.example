VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

VITE_TUYA_API_BASE_URL=https://openapi.tuyaeu.com
VITE_TUYA_DEVICE_ID=your_tuya_device_id
VITE_TUYA_EASY_ACCESS_TOKEN=your_easy_access_token
VITE_TUYA_EASY_REFRESH_TOKEN=your_refresh_token
TUYA_CLIENT_ID=your_tuya_client_id
TUYA_SECRET=your_tuya_secret

SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# --- Payload CMS (blog) -------------------------------------------------------
# Public REST base URL the frontend fetches blog content from.
VITE_PAYLOAD_API_URL=http://localhost:3002/api

# The rest are only needed if you're also running the cms/ app locally
# (see cms/.env.example) — not required just to run the frontend.
DATABASE_URI=postgres://user:pass@host:5432/postgres
PAYLOAD_DB_SCHEMA=payload
PAYLOAD_SECRET=generate_a_long_random_string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3002

S3_BUCKET=blog-media
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=auto
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key