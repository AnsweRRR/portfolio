# Copy to cms/.env for local development.

DATABASE_URI=postgres://user:pass@host:5432/postgres
PAYLOAD_DB_SCHEMA=payload
PAYLOAD_SECRET=generate_a_long_random_string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3002

S3_BUCKET=blog-media
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=auto
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key
