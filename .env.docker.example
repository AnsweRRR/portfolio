# Env vars used by the Docker stack. Copy this to `.env` next to
# docker-compose.yml (GitHub Actions generates it automatically on the Pi).
#
# Locally, the project root's existing `.env` file already contains the Tuya/Supabase
# values, so `pnpm docker:up` works without any extra setup.

# --- which services should start --------------------------------------------
# Empty: only `worker`. This is the default — the webapp and API run on Vercel.
# `full`: `web` and `api` also start, i.e. the Pi hosts the whole stack.
COMPOSE_PROFILES=

# --- web (Caddy) — only matters with COMPOSE_PROFILES=full ------------------
# :80                    -> plain HTTP (LAN, local test)
# portfolio.example.com  -> automatic Let's Encrypt TLS + HTTP->HTTPS redirect
SITE_ADDRESS=:80

# Host ports. If port 80 is taken on your machine, change it here (e.g. 8080).
HTTP_PORT=80
HTTPS_PORT=443

# --- images ------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/answerrr
IMAGE_TAG=latest

# --- api (api/tuya/status.ts, api/weather/history.ts) ------------------------
# Used by the api container when COMPOSE_PROFILES=full; otherwise Vercel handles it.
VITE_TUYA_API_BASE_URL=https://openapi.tuyaeu.com
VITE_TUYA_DEVICE_ID=your_tuya_device_id
TUYA_CLIENT_ID=your_tuya_client_id
TUYA_SECRET=your_tuya_secret

SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# --- worker --------------------------------------------------------------------
TUYA_MSG_REGION=EU
# If > 0, the worker's health endpoint returns 503 once this many ms have passed
# without a Tuya message, and Docker restarts the container. Off by default (0), since
# message frequency is device-dependent and a bad threshold would cause needless restarts.
# The health endpoint still tracks the connection state regardless.
WORKER_STALE_AFTER_MS=0

# --- general -------------------------------------------------------------------
TZ=Europe/Budapest
