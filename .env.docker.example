# A Docker stack által használt env-változók. Másold `.env` néven a
# docker-compose.yml mellé (a Pi-n a GitHub Actions generálja automatikusan).
#
# Lokálisan a projektgyökér meglévő `.env` fájlja már tartalmazza a Tuya/Supabase
# értékeket, így a `pnpm docker:up` külön beállítás nélkül is elindul.

# --- mely szolgáltatások induljanak ----------------------------------------
# Üresen: csak a `worker`. Ez az alapeset — a webapp és az API a Vercelen fut.
# `full`: a `web` és `api` is elindul, azaz a Pi a teljes stacket hostolja.
COMPOSE_PROFILES=

# --- web (Caddy) — csak COMPOSE_PROFILES=full esetén számít ----------------
# :80                    -> sima HTTP (LAN, lokális teszt)
# portfolio.pelda.hu     -> automatikus Let's Encrypt TLS + HTTP->HTTPS redirect
SITE_ADDRESS=:80

# Host portok. Ha a 80-as foglalt a gépeden, itt írd át (pl. 8080).
HTTP_PORT=80
HTTPS_PORT=443

# --- image-ek --------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/answerrr
IMAGE_TAG=latest

# --- api (api/tuya/status.ts, api/weather/history.ts) ----------------------
# COMPOSE_PROFILES=full esetén az api konténer használja; egyébként a Vercel.
VITE_TUYA_API_BASE_URL=https://openapi.tuyaeu.com
VITE_TUYA_DEVICE_ID=your_tuya_device_id
TUYA_CLIENT_ID=your_tuya_client_id
TUYA_SECRET=your_tuya_secret

SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# --- worker ----------------------------------------------------------------
TUYA_MSG_REGION=EU
# > 0 esetén a worker health endpointja 503-at ad, ha ennyi ideje nem érkezett
# Tuya üzenet, és a Docker újraindítja a konténert. Alapból kikapcsolva (0), mert
# az üzenetek gyakorisága eszközfüggő és egy rossz küszöb felesleges restartokat
# okozna. A kapcsolat állapotát a health endpoint így is figyeli.
WORKER_STALE_AFTER_MS=0

# --- általános -------------------------------------------------------------
TZ=Europe/Budapest
