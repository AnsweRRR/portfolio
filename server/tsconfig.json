{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // The `api/` folder wasn't type-checked by anything before (tsconfig.app.json only
  // looks at `src`, and Vercel compiles it separately) — from here on `typecheck:server`
  // covers the server and its handlers too.
  "include": ["**/*.ts", "../api/**/*.ts"]
}
