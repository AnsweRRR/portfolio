# Build output — the builder stage regenerates it (dist/ is ~39 MB locally).
node_modules
**/node_modules
dist
**/dist
build

# Version control / CI / editor
.git
.gitignore
.github
.vscode
.idea

# Secrets: must never end up in the build context, not even in an intermediate layer.
.env
.env.*
!.env.docker.example

# Deploy platform artifacts
.vercel
.vercelignore

# Docker's own files (the Dockerfile doesn't need them in the context)
Dockerfile
.dockerignore
docker-compose*.yml

# Docs and other files not needed for the build
*.md
LICENSE
.eslintcache
coverage
*.log
