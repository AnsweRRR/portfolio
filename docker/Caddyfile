# Caddy config for the `web` container: static SPA serving, /api proxy
# to the `api` container, and — with a domain — automatic Let's Encrypt TLS.
#
# A single env var switches the behavior:
#   SITE_ADDRESS=:80                  -> plain HTTP (LAN, local test)
#   SITE_ADDRESS=portfolio.example.com   -> automatic HTTPS + HTTP->HTTPS redirect
#
# If you need Let's Encrypt expiry notifications, add the global
# `email someone@example.com` option here (left empty since a Caddyfile parse
# error would result otherwise, so it's not wired from an env var).

{
	admin off
}

# Internal healthcheck endpoint. Deliberately a separate site instead of the main
# one: with a domain, the main site would issue an HTTP->HTTPS redirect on port 80,
# which would make the healthcheck falsely report "unhealthy".
:8080 {
	log {
		output discard
	}
	respond /healthz "ok" 200
	respond 404
}

{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3001}
	}

	# The hashed Vite assets are DELIBERATELY in their own handle, with no SPA fallback:
	# a request for a nonexistent /assets/... should 404, not 200 + index.html.
	# The fallback there would make the browser receive HTML instead of .js, and
	# fail silently. This becomes an issue when the same hostname is served by two
	# separate builds (Vercel + Pi): the chunk hashes can differ, and a redirected
	# client can request a stale asset URL.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv

		# `route`, not a plain directive list: Caddy runs directives in its own
		# default order, where `header` runs BEFORE `try_files`.
		# Because of that, the `/index.html` matcher wouldn't match `/` or the
		# deep links, and the entrypoint would go out without a Cache-Control header.
		# `route` preserves the order written here, so we can also match against
		# the route AFTER the rewrite.
		route {
			# The service worker must never be cached.
			header /sw.js Cache-Control "no-cache"

			# SPA history fallback — for react-router BrowserRouter deep links
			# (e.g. opening /projects directly, or an F5 refresh).
			try_files {path} /index.html

			# Running after the rewrite, this covers `/` and every deep link too.
			# Without it, users would get stuck on a stale build.
			header /index.html Cache-Control "no-cache"

			file_server
		}
	}
}
