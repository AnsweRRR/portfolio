# Env vars used by the Docker stack. Copy this to `.env` next to
# docker-compose.yml (GitHub Actions generates it automatically on the Pi).
#
# Locally, the project root's existing `.env` file already contains the Tuya/Supabase
# values, so `pnpm docker:up` works without any extra setup.

# --- which services should start --------------------------------------------
# Empty: `worker`, `cms`, and `cms-proxy`. This is the default — the webapp and
# API run on Vercel, but the Pi always hosts the worker and the blog CMS.
# `full`: `web` and `api` also start, i.e. the Pi hosts the whole stack.
COMPOSE_PROFILES=

# --- web (Caddy) — only matters with COMPOSE_PROFILES=full ------------------
# :80                    -> plain HTTP (LAN, local test)
# portfolio.example.com  -> automatic Let's Encrypt TLS + HTTP->HTTPS redirect
SITE_ADDRESS=:80

# Host ports. If port 80 is taken on your machine, change it here (e.g. 8080).
HTTP_PORT=80
HTTPS_PORT=443

# --- images ------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/answerrr
IMAGE_TAG=latest

# --- api (api/tuya/status.ts, api/weather/history.ts) ------------------------
# Used by the api container when COMPOSE_PROFILES=full; otherwise Vercel handles it.
VITE_TUYA_API_BASE_URL=https://openapi.tuyaeu.com
VITE_TUYA_DEVICE_ID=your_tuya_device_id
TUYA_CLIENT_ID=your_tuya_client_id
TUYA_SECRET=your_tuya_secret

SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# --- cms (Payload) — always starts, regardless of COMPOSE_PROFILES ----------
# Leave CMS_ADDRESS as :8081 (plain HTTP): the Pi has no public IPv4 to point a
# domain at, so cloudflared (below) exposes cms-proxy to the internet via a
# Cloudflare Tunnel instead of Caddy's own Let's Encrypt — Cloudflare's edge
# terminates public TLS, Caddy only ever needs to answer on the internal network.
CMS_ADDRESS=:8081
CMS_HTTP_PORT=8081
CMS_HTTPS_PORT=8444

DATABASE_URI=postgres://user:pass@host:5432/postgres
PAYLOAD_DB_SCHEMA=payload
PAYLOAD_SECRET=your_payload_secret
# The PUBLIC address, used by Payload for links/emails — NOT the same as
# CMS_ADDRESS above. This is what the Cloudflare Tunnel's public hostname is set to.
PAYLOAD_PUBLIC_SERVER_URL=https://cms.example.com

S3_BUCKET=blog-media
S3_ENDPOINT=your_supabase_s3_endpoint
S3_REGION=auto
S3_ACCESS_KEY_ID=your_supabase_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_access_key

# --- cloudflared (Cloudflare Tunnel) -----------------------------------------
# Connector token from Cloudflare Zero Trust -> Networks -> Tunnels -> (your
# tunnel) -> Configure. Only this token is needed here; the public hostname ->
# service mapping (cms.example.com -> http://cms-proxy:80) and DNS record are
# both configured in the Cloudflare dashboard, not in this repo.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# --- worker --------------------------------------------------------------------
TUYA_MSG_REGION=EU
# If > 0, the worker's health endpoint returns 503 once this many ms have passed
# without a Tuya message, and Docker restarts the container. Off by default (0), since
# message frequency is device-dependent and a bad threshold would cause needless restarts.
# The health endpoint still tracks the connection state regardless.
WORKER_STALE_AFTER_MS=0

# --- general -------------------------------------------------------------------
TZ=Europe/Budapest
