{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundles": "node scripts/build-bundles.mjs",
    "lint": "eslint .",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "worker:dev": "pnpm --filter portfolio-tuya-worker dev",
    "cms:dev": "pnpm --filter portfolio-cms dev",
    "cms:migrate": "pnpm --filter portfolio-cms migrate",
    "cms:seed:ollama-post": "pnpm --filter portfolio-cms exec tsx scripts/seed-ollama-post.ts",
    "cms:generate:importmap": "pnpm --filter portfolio-cms generate:importmap",
    "dev:api": "tsx watch server/index.ts",
    "dev:app": "concurrently \"pnpm run dev:api\" \"pnpm run dev\"",
    "dev:all": "concurrently \"pnpm run dev:api\" \"pnpm run worker:dev\" \"pnpm run cms:dev\" \"pnpm run dev\"",
    "docker:build": "docker compose --profile full build",
    "docker:up": "docker compose up -d --build web api cms cms-proxy",
    "docker:up:all": "docker compose --profile full up -d --build",
    "docker:down": "docker compose --profile full down",
    "docker:logs": "docker compose --profile full logs -f"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "crypto-js": "^4.2.0",
    "emailjs-com": "^3.2.0",
    "framer-motion": "^13.1.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "maath": "^0.10.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.9.9",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vercel": "^58.11.0",
    "vite": "^8.2.1"
  }
}
